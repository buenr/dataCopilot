APP_ENV=development
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
SESSION_TTL_MINUTES=30
SESSION_VOLUME_PREFIX=dc
SANDBOX_IMAGE=data-copilot-sandbox:latest
SANDBOX_NETWORK=data-copilot-sandbox
SANDBOX_ALLOW_EGRESS=false
DOCKER_SOCKET=unix:///var/run/docker.sock
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_MODEL=gpt-5.6
# Optional reasoning effort for OpenAI reasoning models. gpt-5.6-luna
# supports none, low, medium, high, xhigh, max (default: high).
OPENAI_REASONING_EFFORT=
